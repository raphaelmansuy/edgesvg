---
interface Feature {
  icon: string;
  title: string;
  description: string;
}
interface Props {
  title: string;
  subtitle: string;
  features: Feature[];
}
const { title, subtitle, features } = Astro.props;

const iconPaths: Record<string,string> = {
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  target: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zm0-6a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2a2 2 0 1 1 0-4 2 2 0 0 1 0 4z',
  layers: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  globe: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM2.32 7h19.36M2.32 17h19.36M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20',
  cpu: 'M18 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3',
  box: 'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  chart: 'M18 20V10M12 20V4M6 20v-6',
  image: 'M21 19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14zM8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21',
  tool: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  refresh: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
};
---
<section class="feature-grid">
  <div class="feature-grid-header">
    <h2>{title}</h2>
    <p>{subtitle}</p>
  </div>
  <div class="feature-grid-cards">
    {features.map(f => (
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPaths[f.icon] || iconPaths.box} />
          </svg>
        </div>
        <h3>{f.title}</h3>
        <p>{f.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-grid { padding: 5rem 2rem; max-width: 1100px; margin: 0 auto; }
  .feature-grid-header { text-align: center; margin-bottom: 3rem; }
  .feature-grid-header h2 { font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 800; margin-bottom: 0.75rem; color: var(--es-text-primary, #111827); }
  .feature-grid-header p { font-size: 1.05rem; color: var(--es-text-secondary, #4b5563); max-width: 600px; margin: 0 auto; }
  .feature-grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .feature-card {
    padding: 1.75rem;
    background: var(--es-bg-subtle, #f9fafb);
    border: 1px solid var(--es-border, #e5e7eb);
    border-radius: 0.75rem;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .feature-card:hover { border-color: var(--sl-color-accent, #10b981); transform: translateY(-2px); box-shadow: 0 4px 20px rgba(16,185,129,0.1); }
  .feature-icon { width: 42px; height: 42px; border-radius: 0.5rem; background: var(--es-accent-glow, rgba(16,185,129,0.12)); display: flex; align-items: center; justify-content: center; color: var(--sl-color-accent, #10b981); margin-bottom: 1rem; }
  .feature-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--es-text-primary, #111827); }
  .feature-card p { font-size: 0.9rem; color: var(--es-text-secondary, #4b5563); line-height: 1.6; }
</style>
