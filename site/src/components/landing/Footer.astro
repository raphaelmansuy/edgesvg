      </div>
    </div>
    <div class="footer-links">
      <div class="footer-link-group">
        <h3>Getting Started</h3>
        <a href={`${base}getting-started/quick-start-python/`}>Python</a>
        <a href={`${base}getting-started/quick-start-nodejs/`}>Node.js</a>
        <a href={`${base}getting-started/quick-start-cli/`}>CLI</a>
        <a href={`${base}getting-started/quick-start-rust/`}>Rust</a>
        <a href={`${base}getting-started/quick-start-wasm/`}>WebAssembly</a>
      </div>
      <div class="footer-link-group">
        <h3>API Reference</h3>
        <a href={`${base}api/python/`}>Python SDK</a>
        <a href={`${base}api/nodejs/`}>Node.js SDK</a>
        <a href={`${base}api/cli/`}>CLI Reference</a>
        <a href={`${base}api/rust/`}>Rust API</a>
        <a href={`${base}api/wasm/`}>WASM SDK</a>
      </div>
      <div class="footer-link-group">
        <h3>Guides</h3>
        <a href={`${base}guides/batch-conversion/`}>Batch Conversion</a>
        <a href={`${base}guides/cicd/`}>CI/CD & Publishing</a>
        <a href={`${base}concepts/algorithm/`}>Algorithm</a>
        <a href={`${base}concepts/quality-metrics/`}>Quality Metrics</a>
        <a href={`${base}concepts/modes/`}>Vectorization Modes</a>
        <a href={`${base}demo/`} target="_blank" rel="noopener">Live Demo ↗</a>
      </div>
      <div class="footer-link-group">
        <h3>SDKs</h3>
        <a href="https://pypi.org/project/edgesvg/" target="_blank" rel="noopener">Python (PyPI)</a>
        <a href="https://www.npmjs.com/package/edgesvg" target="_blank" rel="noopener">Node.js (npm)</a>
        <a href="https://crates.io/crates/edgesvg" target="_blank" rel="noopener">Rust (crates.io)</a>
        <a href={`${base}getting-started/quick-start-wasm/`}>WebAssembly</a>
      </div>
      <div class="footer-link-group">
        <h3>Project</h3>
        <a href="https://github.com/raphaelmansuy/edgesvg" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/raphaelmansuy/edgesvg/issues" target="_blank" rel="noopener">Issues</a>
        <a href="https://github.com/raphaelmansuy/edgesvg/discussions" target="_blank" rel="noopener">Discussions</a>
        <a href={`${base}changelog/`}>Changelog</a>
        <a href="https://github.com/raphaelmansuy/edgesvg/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a>
        <a href="https://github.com/raphaelmansuy/edgesvg/blob/main/LICENSE" target="_blank" rel="noopener">License (Apache 2.0)</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>Apache 2.0 · Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> &amp; <a href="https://starlight.astro.build" target="_blank" rel="noopener">Starlight</a></span>
    <span>© {new Date().getFullYear()} Raphael Mansuy</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--es-border, #e5e7eb);
    padding: 3rem 2rem 1.5rem;
    margin-top: 4rem;
    background: var(--es-bg-subtle, #f9fafb);
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
  }
  .footer-brand { max-width: 220px; }
  .footer-logo { font-size: 1.25rem; font-weight: 800; color: var(--es-text-primary, #111827); }
  .footer-logo-accent { color: var(--sl-color-accent, #10b981); }
  .footer-tagline { margin-top: 0.5rem; font-size: 0.85rem; color: var(--es-text-secondary, #6b7280); line-height: 1.6; }
  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--es-border, #e5e7eb);
    color: var(--es-text-secondary, #4b5563);
    transition: background 0.15s, color 0.15s;
  }
  .footer-social a:hover {
    background: var(--sl-color-accent, #10b981);
    color: #fff;
  }
  .footer-links { display: flex; gap: 2rem; flex-wrap: wrap; }
  .footer-link-group { display: flex; flex-direction: column; gap: 0.45rem; min-width: 130px; }
  .footer-link-group h3 { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--es-text-secondary, #9ca3af); margin-bottom: 0.35rem; }
  .footer-link-group a { font-size: 0.875rem; color: var(--es-text-secondary, #4b5563); text-decoration: none; transition: color 0.15s; }
  .footer-link-group a:hover { color: var(--sl-color-accent, #10b981); }
  .footer-bottom {
    max-width: 1200px;
    margin: 2rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--es-border, #e5e7eb);
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--es-text-secondary, #9ca3af);
  }
  .footer-bottom a { color: inherit; text-decoration: none; }
  .footer-bottom a:hover { color: var(--sl-color-accent, #10b981); }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
    .footer-brand { max-width: 100%; }
    .footer-links { gap: 1.5rem; }
    .footer-bottom { flex-direction: column; gap: 0.5rem; }
  }
</style>
